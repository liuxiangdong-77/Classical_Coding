{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "用 VS 2022 的 MSVC 工具链 + nvcc，构建目录为 build/",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "带调试信息、不优化，适合单步调试",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "开优化，适合看性能",
      "configurePreset": "vs2022",
      "configuration": "Release"
    }
  ]
}
