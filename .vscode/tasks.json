{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置",
      "detail": "cmake --preset vs2022 —— 生成 build/",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "vs2022"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 构建 Debug",
      "detail": "编译 Debug 版 → build\\bin\\vector_add.exe",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: 配置",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 构建 Release",
      "detail": "编译带优化的 Release 版 → build\\bin\\vector_add.exe",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: 配置",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 运行",
      "detail": "运行 build\\bin\\vector_add.exe",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\bin\\vector_add.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      // "dependsOn": "CMake: 构建 Debug",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: 清理",
      "detail": "删除整个 build/ 目录（下次构建会重新配置）",
      "type": "shell",
      "command": "cmake",
      "args": ["-E", "remove_directory", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
