{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": "$gcc",
            "detail": "CMake 配置，生成构建文件"
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "cmake-configure",
            "problemMatcher": "$gcc",
            "detail": "编译工程，等价于 cmake --build build"
        },
        {
            "label": "run-snake",
            "type": "shell",
            "command": "${workspaceFolder}/build/snake",
            "windows": {
                "command": "chcp 65001 > nul && \"${workspaceFolder}\\build\\Debug\\SnakeGame.exe\""
            },
            "args": [],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            },
            "detail": "运行贪吃蛇程序"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "clean"
            ],
            "problemMatcher": "$gcc",
            "detail": "清理编译产物"
        }
    ]
}
